rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile: only the authenticated owner can read & write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's private cases subcollection (Khana-2, PPAS, Legal Heir)
      match /cases/{caseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's private disaster management & house damage records
      match /disaster_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all for any user-scoped subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

